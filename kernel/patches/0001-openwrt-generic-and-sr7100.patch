+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ZX279133 PCIe0 x2 PHY sequence recovered from the local vendor Image.
+ * Evidence: analysis/openwrt/pcie/provenance.json, vendor-pcie.disasm.txt.
+ * Source function: zx133_pcie_controller_setup, x2 branch at ...103c7ff8.
+ *
+ * This is NOT a complete PCIe host driver. The caller must first establish
+ * power, pinmux and shared Top/Sys reset ordering. DMA shutdown, endpoint
+ * reset, IRQ/MSI and DesignWare host integration remain separate work.
+ * Do not call against an active vendor-controlled PCIe/Wi-Fi device.
+ */
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <linux/kernel.h>
+#include "zx279133-phy.h"
+
+struct zx279133_phy_write {
+	u32 offset;
+	u32 value;
+};
+
+static const struct zx279133_phy_write zx279133_phy_x2[] = {
+	{ 0x000, 0x7ffff0f0 },
+	{ 0x174, 0x00752752 }, { 0x338, 0x00752752 },
+	{ 0x17c, 0x00643643 }, { 0x340, 0x00643643 },
+	{ 0x00c, 0x00080016 }, { 0x1cc, 0x00080016 },
+	{ 0x11c, 0x60000d10 }, { 0x0a4, 0x183e0000 },
+	{ 0x0b4, 0x0000d009 }, { 0x15c, 0x07d55000 },
+	{ 0x160, 0x030e3f00 }, { 0x168, 0x102a5880 },
+	{ 0x16c, 0x0000000b }, { 0x180, 0x01970377 },
+	{ 0x184, 0x00190287 }, { 0x188, 0x00190028 },
+	{ 0x2e0, 0x00000d10 }, { 0x2e4, 0x08310142 },
+	{ 0x30c, 0x0222000c }, { 0x320, 0x07d55000 },
+	{ 0x324, 0x030e3f00 }, { 0x32c, 0x102c5880 },
+	{ 0x330, 0x0000000b }, { 0x344, 0x01970377 },
+	{ 0x348, 0x00190287 }, { 0x34c, 0x00190028 },
+	{ 0x264, 0x183e0000 }, { 0x274, 0x0000d009 },
+	{ 0x290, 0x07000000 }, { 0x2a4, 0x00005034 },
+	{ 0x124, 0x00c21407 }, { 0x11c, 0x60000d00 },
+	{ 0x128, 0x017c0010 }, { 0x2e8, 0x00c21407 },
+	{ 0x2e0, 0x20400d00 }, { 0x2ec, 0x017c0010 },
+};
+
+void zx279133_pcie_phy_program_x2(void __iomem *phy)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(zx279133_phy_x2); i++)
+		writel(zx279133_phy_x2[i].value,
+		       phy + zx279133_phy_x2[i].offset);
+
+	writel(readl(phy) | 0x808, phy);
+	mdelay(10);
+	writel(readl(phy) | 0x707, phy);
+	mdelay(500);
+}
+
+int zx279133_pcie_phy_wait_x2(void __iomem *csr)
+{
+	u32 status;
+
+	/* The vendor loops forever on bits 14/15. Bound the new driver's wait.
+	 * This 500 ms polling limit is a port policy, not a recovered timing.
+	 */
+	return readl_poll_timeout(csr + 0x10cc, status,
+				 !(status & 0xc000), 1000, 500000);
+}
