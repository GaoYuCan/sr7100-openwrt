@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Experimental ZX279133 PCIe0 x2 host glue for Linux 6.12.
+ * Recovered behavior: vendor zx_pcie_probe, zx133_pcie_controller_setup,
+ * zx_pcie_setup_rc; see analysis/openwrt/pcie for instruction evidence.
+ * Legacy INTx only. MSI routing, hotplug and vendor DMA handoff are not implemented.
+ * The development board DT deliberately leaves this controller disabled.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include "pcie-designware.h"
+#include "zx279133-phy.h"
+
+struct zx279133_pcie {
+	struct dw_pcie pci;
+	void __iomem *csr;
+	void __iomem *phy;
+	void __iomem *irq_mode;
+	struct regmap *sys;
+	struct reset_control *reset;
+	struct clk_bulk_data clocks[2];
+	struct gpio_descs *power;
+	bool link_started;
+};
+
+static struct zx279133_pcie *to_zx(struct dw_pcie *pci)
+{
+	return container_of(pci, struct zx279133_pcie, pci);
+}
+
+static int zx279133_power_sequence(struct zx279133_pcie *zx)
+{
+	unsigned int i;
+	int ret;
+
+	/* DT order is vendor GPIO 18, 37, 7, 8, 38. All values are raw levels.
+	 * Their individual electrical roles have not been independently measured.
+	 */
+	for (i = 0; i < 5; i++) {
+		ret = gpiod_direction_output_raw(zx->power->desc[i], 0);
+		if (ret)
+			return ret;
+	}
+	gpiod_set_raw_value_cansleep(zx->power->desc[0], 1);
+	usleep_range(3000, 3500);
+	gpiod_set_raw_value_cansleep(zx->power->desc[1], 1);
+	usleep_range(3000, 3500);
+	gpiod_set_raw_value_cansleep(zx->power->desc[2], 1);
+	msleep(18);
+	gpiod_set_raw_value_cansleep(zx->power->desc[3], 1);
+	msleep(500);
+	gpiod_set_raw_value_cansleep(zx->power->desc[4], 1);
+	return 0;
+}
+
+static int zx279133_host_init(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct zx279133_pcie *zx = to_zx(pci);
+	int ret;
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(zx->clocks), zx->clocks);
+	if (ret)
+		return ret;
+	ret = zx279133_power_sequence(zx);
+	if (ret)
+		goto clocks_off;
+	ret = regmap_update_bits(zx->sys, 0x40, BIT(0), 0);
+	if (ret)
+		goto clocks_off;
+	ret = regmap_update_bits(zx->sys, 0x48, BIT(0), 0);
+	if (ret)
+		goto clocks_off;
+	ret = reset_control_assert(zx->reset);
+	if (ret)
+		goto clocks_off;
+	udelay(500);
+	ret = reset_control_deassert(zx->reset);
+	if (ret)
+		goto clocks_off;
+	udelay(500);
+	zx279133_pcie_phy_program_x2(zx->phy);
+	ret = zx279133_pcie_phy_wait_x2(zx->csr);
+	if (ret)
+		goto clocks_off;
+	ret = regmap_update_bits(zx->sys, 0x40, BIT(0), BIT(0));
+	if (ret)
+		goto clocks_off;
+	ret = regmap_update_bits(zx->sys, 0x48, BIT(0), BIT(0));
+	if (ret)
+		goto clocks_off;
+
+	/* zte,133 maps to vendor current_cputype=8, not the 132 path. */
+	dw_pcie_dbi_ro_wr_en(pci);
+	dw_pcie_writel_dbi(pci, 0x708, 0x00400004);
+	dw_pcie_writel_dbi(pci, 0x8a8,
+		(dw_pcie_readl_dbi(pci, 0x8a8) & 0xff0000ff) | 0x2200);
+	dw_pcie_dbi_ro_wr_dis(pci);
+	/* A new host must not inherit the vendor's enabled MSI receiver. */
+	dw_pcie_writel_dbi(pci, PCIE_MSI_INTR0_ENABLE, 0);
+	dw_pcie_writel_dbi(pci, PCIE_MSI_INTR0_MASK, ~0U);
+	return 0;
+
+clocks_off:
+	clk_bulk_disable_unprepare(ARRAY_SIZE(zx->clocks), zx->clocks);
+	return ret;
+}
+
+static int zx279133_link_up(struct dw_pcie *pci)
+{
+	/* Force post-setup quirks even if firmware left a stale link-up bit. */
+	return to_zx(pci)->link_started &&
+	       !!(readl(to_zx(pci)->csr + 0x1100) & BIT(0));
+}
+
+static int zx279133_start_link(struct dw_pcie *pci)
+{
+	struct zx279133_pcie *zx = to_zx(pci);
+	u32 status;
+	int ret;
+
+	dw_pcie_dbi_ro_wr_en(pci);
+	dw_pcie_writel_dbi(pci, 0x890, dw_pcie_readl_dbi(pci, 0x890) & ~BIT(16));
+	msleep(10);
+	dw_pcie_writel_dbi(pci, 0x154, 0xff52ff52);
+	dw_pcie_writel_dbi(pci, 0x8c4, dw_pcie_readl_dbi(pci, 0x8c4) & ~0xff);
+	msleep(100);
+	dw_pcie_dbi_ro_wr_dis(pci);
+	writel(readl(zx->csr + 0x1008) | BIT(11), zx->csr + 0x1008);
+	msleep(200);
+	writel(readl(zx->irq_mode) | (3 << 18), zx->irq_mode);
+	msleep(100);
+	ret = readl_poll_timeout(zx->csr + 0x1100, status,
+				 status & BIT(0), 20000, 4000000);
+	if (ret)
+		dev_err(pci->dev, "PCIe0 link did not come up\n");
+	else
+		zx->link_started = true;
+	return ret;
+}
+
+static void zx279133_stop_link(struct dw_pcie *pci)
+{
+	struct zx279133_pcie *zx = to_zx(pci);
+
+	zx->link_started = false;
+	/* Inverse of the observed enable operation; electrical stop behavior
+	 * is unverified. This is not a vendor DMA shutdown protocol.
+	 */
+	writel(readl(zx->csr + 0x1008) & ~BIT(11), zx->csr + 0x1008);
+}
+
+static void zx279133_host_deinit(struct dw_pcie_rp *pp)
+{
+	struct zx279133_pcie *zx = to_zx(to_dw_pcie_from_pp(pp));
+
+	clk_bulk_disable_unprepare(ARRAY_SIZE(zx->clocks), zx->clocks);
+}
+
+static int zx279133_intx_only(struct dw_pcie_rp *pp)
+{
+	/* Do not instantiate the generic DWC MSI receiver: this SoC routes MSI
+	 * through a separate vendor block. No MSI domain means PCI falls back
+	 * to the explicit INTx interrupt-map. mt7996 requests ALL_TYPES.
+	 */
+	return 0;
+}
+
+static const struct dw_pcie_ops zx279133_ops = {
+	.link_up = zx279133_link_up,
+	.start_link = zx279133_start_link,
+	.stop_link = zx279133_stop_link,
+};
+
+static const struct dw_pcie_host_ops zx279133_host_ops = {
+	.init = zx279133_host_init,
+	.deinit = zx279133_host_deinit,
+	.msi_init = zx279133_intx_only,
+};
+
+static int zx279133_pcie_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct zx279133_pcie *zx;
+	u32 lanes, domain;
+	int ret;
+
+	if (of_property_read_u32(dev->of_node, "num-lanes", &lanes) || lanes != 2 ||
+	    of_property_read_u32(dev->of_node, "linux,pci-domain", &domain) || domain)
+		return dev_err_probe(dev, -EINVAL, "only PCIe0 x2 is implemented\n");
+	zx = devm_kzalloc(dev, sizeof(*zx), GFP_KERNEL);
+	if (!zx)
+		return -ENOMEM;
+	zx->pci.dev = dev;
+	zx->pci.ops = &zx279133_ops;
+	zx->pci.pp.ops = &zx279133_host_ops;
+	zx->csr = devm_platform_ioremap_resource_byname(pdev, "csr");
+	if (IS_ERR(zx->csr))
+		return PTR_ERR(zx->csr);
+	zx->phy = devm_platform_ioremap_resource_byname(pdev, "phy");
+	if (IS_ERR(zx->phy))
+		return PTR_ERR(zx->phy);
+	zx->irq_mode = devm_platform_ioremap_resource_byname(pdev, "irq-mode");
+	if (IS_ERR(zx->irq_mode))
+		return PTR_ERR(zx->irq_mode);
+	zx->sys = syscon_regmap_lookup_by_phandle(dev->of_node, "zte,syscon");
+	if (IS_ERR(zx->sys))
+		return dev_err_probe(dev, PTR_ERR(zx->sys), "missing PCIe syscon\n");
+	zx->reset = devm_reset_control_get_exclusive(dev, "core");
+	if (IS_ERR(zx->reset))
+		return dev_err_probe(dev, PTR_ERR(zx->reset), "missing core reset\n");
+	zx->clocks[0].id = "pclk";
+	zx->clocks[1].id = "cci";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(zx->clocks), zx->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing PCIe clocks\n");
+	zx->power = devm_gpiod_get_array(dev, "vendor-power", GPIOD_ASIS);
+	if (IS_ERR(zx->power))
+		return dev_err_probe(dev, PTR_ERR(zx->power), "missing board power sequence\n");
+	if (zx->power->ndescs != 5)
+		return dev_err_probe(dev, -EINVAL, "expected five board power GPIOs\n");
+	platform_set_drvdata(pdev, zx);
+	return dw_pcie_host_init(&zx->pci.pp);
+}
+
+static const struct of_device_id zx279133_pcie_of_match[] = {
+	{ .compatible = "zte,zx279133-pcie" },
+	{ }
+};
+
+static struct platform_driver zx279133_pcie_driver = {
+	.probe = zx279133_pcie_probe,
+	.driver = {
+		.name = "zx279133-pcie",
+		.of_match_table = zx279133_pcie_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(zx279133_pcie_driver);
+MODULE_DESCRIPTION("Experimental ZTE ZX279133 PCIe0 host controller");
+MODULE_LICENSE("GPL");
