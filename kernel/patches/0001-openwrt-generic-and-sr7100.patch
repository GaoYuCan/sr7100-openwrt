-
-	if (!phydev->link)
-		return 0;
-
-	/* Read actual speed from vendor register. */
-	val = phy_read_mmd(phydev, MDIO_MMD_VEND2, RTL822X_VND2_PHYSR);
-	if (val < 0)
-		return val;
