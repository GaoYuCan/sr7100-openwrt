+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+/dts-v1/;
+#include "zx279133.dtsi"
+#include "zx279133-pcie.dtsi"
+
+/ {
+	model = "ZTE ZX279133 F35SQA RAM development board";
+	compatible = "zte,zx279133-f35sqa", "zte,zx279133";
+	aliases {
+		serial0 = &uart0;
+		gpio0 = &gpio0;
+		gpio1 = &gpio1;
+		gpio2 = &gpio2;
+		gpio3 = &gpio3;
+		gpio4 = &gpio4;
+	};
+	chosen {
+		stdout-path = "serial0:115200n8";
+		/* Preserve firmware clocks while DMA/watchdog handoff is unresolved. */
+		bootargs = "console=ttyAMA0,115200 earlycon=zteuart,0x10d0d000 rdinit=/init clk_ignore_unused";
+	};
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0 0x80000000 0 0x20000000>;
+	};
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		/* Conservative reservation from this device's live memory inventory.
+		 * Reserving buffers does not quiesce the vendor DMA engines.
+		 */
+		vendor-high@9a600000 {
+			reg = <0 0x9a600000 0 0x05a00000>;
+			no-map;
+		};
+		vendor-low@85ff3000 {
+			reg = <0 0x85ff3000 0 0x0000a000>;
+			no-map;
+		};
+	};
+};
+
+&uart0 { status = "okay"; };
+
+/* The driver is built for API validation, but takeover is not validated yet.
+ * These disabled nodes do NOT stop watchdogs left running by vendor Linux.
+ */
+&watchdog0 { status = "disabled"; };
+&watchdog1 { status = "disabled"; };
+
+&pcie0 {
+	/* Exact vendor call order, not inferred electrical signal names. */
+	vendor-power-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>,
+			     <&gpio2 5 GPIO_ACTIVE_HIGH>,
+			     <&gpio0 7 GPIO_ACTIVE_HIGH>,
+			     <&gpio0 8 GPIO_ACTIVE_HIGH>,
+			     <&gpio2 6 GPIO_ACTIVE_HIGH>;
+	status = "disabled"; /* Complete old-kernel DMA/watchdog handoff first. */
+};
+
+/* Flash, Ethernet, USB and eFuse access are not part of this RAM core image. */
