-
-	ret = genphy_update_link(phydev);
-	if (ret)
-		return ret;
-
-	ret = phy_read(phydev, MII_CTRL1000);
-	if (ret < 0)
-		return ret;
-	if (ret & CTL1000_AS_MASTER)
-		phydev->master_slave_get = MASTER_SLAVE_CFG_MASTER_FORCE;
-	else
-		phydev->master_slave_get = MASTER_SLAVE_CFG_SLAVE_FORCE;
