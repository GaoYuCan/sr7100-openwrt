+	};
+
+	psci {
+		compatible = "arm,psci-0.2";
+		method = "smc";
+	};
+
+	gic: interrupt-controller@500000 {
+		compatible = "arm,gic-v3";
+		#address-cells = <0>;
+		#interrupt-cells = <3>;
+		interrupt-controller;
+		reg = <0x0 0x00500000 0x0 0x10000>,
+		      <0x0 0x00540000 0x0 0x80000>;
+		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	timer {
