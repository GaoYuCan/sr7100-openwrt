+
+struct net_mgr {
+	enum net_trig_type type; /* family: lan/wan/wlan */
+
+	struct mutex lock;
+	struct notifier_block notifier;
+	struct delayed_work work;
+
+	struct net_device *devs[MAX_IFACES];
+	int dev_slot_limit;
+
+	u64 agg_tx_packets;
+	u64 agg_rx_packets;
+	u64 agg_tx_bytes;
