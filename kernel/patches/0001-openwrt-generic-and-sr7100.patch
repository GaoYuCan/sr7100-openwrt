+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+#include <dt-bindings/gpio/gpio.h>
+
+&pinctrl {
+	pcie0_pins: pcie0-pins { function = "pcie0"; pins = "p4-2", "p4-3"; };
+	pcie1_pins: pcie1-pins { function = "pcie1"; pins = "p4-4", "p4-5"; };
+};
+
+/ {
+	soc {
+		pcie_sys: syscon@10e00000 {
+			compatible = "zte,zx279133-pcie-sys", "syscon";
+			reg = <0 0x10e00000 0 0x100>;
+		};
+		pcie0: pcie@15200000 {
+			compatible = "zte,zx279133-pcie";
+			device_type = "pci";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			#interrupt-cells = <1>;
+			linux,pci-domain = <0>;
+			bus-range = <0 255>;
+			num-lanes = <2>;
+			max-link-speed = <3>;
+			reg = <0 0x15200000 0 0x2000>,
+			      <0 0x15204000 0 0x1000>,
+			      <0 0x1f000000 0 0x400000>,
+			      <0 0x2f800000 0 0x800000>,
+			      <0 0x00600060 0 4>;
+			reg-names = "csr", "phy", "dbi", "config", "irq-mode";
+			/* MT7992 uses memory BARs. Leave the unused I/O window out. */
+			ranges = <0x02000000 0 0x20000000 0 0x20000000 0 0x0f000000>;
+			dma-ranges = <0x42000000 0 0x80000000 0 0x80000000 0 0x40000000>;
+			dma-coherent;
+			clocks = <&topcrm ZX279133_TOPCRM_CLK_PCIE_PCLK>,
+				 <&topcrm ZX279133_TOPCRM_CLK_PCIE_CCI_ACLK>;
+			clock-names = "pclk", "cci";
+			resets = <&top_reset ZX279133_TOP_RESET_PCIE>;
+			reset-names = "core";
+			zte,syscon = <&pcie_sys>;
+			/* Original DT routes legacy INTA/B/C/D directly to GIC SPIs. */
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &gic GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 2 &gic GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 3 &gic GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 4 &gic GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pcie0_pins &pcie1_pins>;
+			status = "disabled";
+		};
+	};
+};
