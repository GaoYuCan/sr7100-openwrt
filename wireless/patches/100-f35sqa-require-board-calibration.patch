--- a/mt7996/eeprom.c
+++ b/mt7996/eeprom.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/firmware.h>
+#include <linux/of.h>
 #include "mt7996.h"
 #include "eeprom.h"
 
@@ -144,7 +145,7 @@
 	if (ret)
 		return ret;
 
-	if (!fw || !fw->data) {
+	if (!fw || !fw->data || fw->size < MT7996_EEPROM_SIZE) {
 		dev_err(dev->mt76.dev, "Invalid default bin\n");
 		ret = -EINVAL;
 		goto out;
@@ -153,6 +154,13 @@
 	if (!use_default && mt7996_eeprom_variant_valid(dev, fw->data))
 		goto out;
 
+	if (of_machine_is_compatible("zte,zx279133-f35sqa")) {
+		dev_err(dev->mt76.dev,
+			"board calibration mismatch; refusing default EEPROM\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
 	dev_warn(dev->mt76.dev, "eeprom load fail, use default bin\n");
 	memcpy(eeprom, fw->data, MT7996_EEPROM_SIZE);
 	dev->eeprom_mode = EEPROM_MODE_DEFAULT_BIN;
@@ -169,6 +177,18 @@
 	bool use_default = false;
 	int ret, i;
 
+	if (of_machine_is_compatible("zte,zx279133-f35sqa")) {
+		int size;
+		const u8 *data = of_get_property(dev->mt76.dev->of_node,
+						"mediatek,eeprom-data", &size);
+
+		if (!data || size != MT7996_EEPROM_SIZE ||
+		    get_unaligned_le16(data) != MT7992_DEVICE_ID) {
+			dev_err(dev->mt76.dev, "missing or invalid board EEPROM\n");
+			return -EINVAL;
+		}
+	}
+
 	ret = mt76_eeprom_init(&dev->mt76, MT7996_EEPROM_SIZE);
 	if (ret < 0)
 		return ret;
@@ -176,6 +196,11 @@
 	if (ret && !mt7996_check_eeprom(dev)) {
 		dev->eeprom_mode = EEPROM_MODE_FLASH;
 		goto out;
+	}
+
+	if (of_machine_is_compatible("zte,zx279133-f35sqa")) {
+		dev_err(dev->mt76.dev, "board EEPROM not accepted\n");
+		return -EINVAL;
 	}
 
 	memset(dev->mt76.eeprom.data, 0, MT7996_EEPROM_SIZE);
